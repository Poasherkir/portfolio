# Contact form (https://resend.com) — create an API key and verify a sending domain.
# Without this the form returns 503 and no message is delivered.
RESEND_API_KEY=

# Address the contact form delivers to. Falls back to the email in src/data/portfolio.ts.
CONTACT_TO_EMAIL=

# Address the form sends *from*. Must be on a domain verified in Resend.
# Left unset it uses onboarding@resend.dev, which Resend only allows to deliver
# to the address that owns the account — anything else silently fails to arrive.
CONTACT_FROM_EMAIL=

# Public site origin, used for canonical URLs, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=https://malikboudine.vercel.app
